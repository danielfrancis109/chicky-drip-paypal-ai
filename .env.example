# Copy to .env (never commit .env). All values below are placeholders.

# --- Supabase (Lovable Cloud) ---
# Public values (safe in the browser bundle):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
# Server copies of the same public values:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-id
# SERVER ONLY. Needed to write orders/payments (bypasses RLS). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PayPal (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_ENV=sandbox
# Client id is public (sent to the browser to load the PayPal JS SDK).
PAYPAL_CLIENT_ID=your-sandbox-client-id
# SERVER ONLY.
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# --- AI (any OpenAI-compatible Chat Completions API), SERVER ONLY ---
# Leave AI_API_KEY empty to use the built-in rule-based planner (clearly labeled in the UI).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
